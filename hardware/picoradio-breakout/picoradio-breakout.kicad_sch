  (text "picoradio breakout for Raspberry Pi Pico 2 W - pins as in include/config.h (firmware). All connectors: 2.54 mm goldpin headers." (exclude_from_sim no) (at 30.48 152.4 0)
    (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "7d2fecf6-a1f8-4ff6-9c5c-7a8af442b240"))
  (text "ENC1 / ENC2: module order GND S1 S2 KEY +  (power the encoder modules from 3V3, not 5 V)." (exclude_from_sim no) (at 30.48 156.21 0)
    (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "f05b390a-3de5-48b3-bd51-b8bb920346cb"))
  (text "DAC (PCM5102): BCK DATA LRCK GND GND VCC=5V  (on the DAC board: SCK pad to GND, XSMT high)." (exclude_from_sim no) (at 30.48 160.02 0)
    (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "729cdff3-698c-4213-8f88-d6f52f7ea1a6"))
  (text "TFT (ST7789 2.25in): BL CS DC RST SDA SCL VCC=3V3 GND  (the module's pin order, reversed)." (exclude_from_sim no) (at 30.48 163.83 0)
    (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "327642d9-3a86-4e9b-bfaa-ebd15760b7f3"))
  (text "MIC (INMP441): SD WS SCK GND VDD=3V3 L/R=GND.   PWR: +5V = Pico VBUS (from USB), +3V3 = Pico 3V3(OUT)." (exclude_from_sim no) (at 30.48 167.64 0)
    (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "8d88c864-0908-4d2c-8074-218f18472944"))
